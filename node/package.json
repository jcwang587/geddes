{
  "name": "@jcwang587/geddes",
  "version": "1.0.1",
  "description": "Node.js bindings for geddes (Rust XRD parser)",
  "main": "index.js",
  "types": "index.d.ts",
  "homepage": "https://jcwang587.github.io/geddes/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcwang587/geddes.git"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "geddes",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "pack:release": "node ./scripts/pack-release.mjs",
    "check:package": "node ./scripts/check-package.cjs",
    "publish:packages": "node ./scripts/publish-packages.mjs",
    "sync:version": "node ./scripts/sync-version.mjs",
    "prepare:release": "cargo check --manifest-path ../Cargo.toml && cargo check --manifest-path ./Cargo.toml && npm run sync:version",
    "artifacts": "napi create-npm-dirs && napi artifacts --output-dir .",
    "build": "npm run sync:version && napi build --platform --release",
    "version": "npm run sync:version && napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1"
  }
}
